# AI Configuration (OpenAI-compatible endpoint)
AI_ENDPOINT=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-3-haiku
AI_AUTH_TOKEN=sk-or-v1-your-key-here

# Kick Configuration
KICK_CHANNEL_SLUG=your-channel-slug
KICK_AUTH_TOKEN=your-kick-auth-token

# RTMP Stream (AWS IVS ingest: rtmps://<host>:443/app/<stream-key>)
RTMP_URL=rtmps://fa723fc1b171.global-contribute.live-video.net:443/app
RTMP_STREAM_KEY=sk_us-west-2_your-stream-key

# Web Agent
WEB_PORT=8080

# System Prompt
SYSTEM_PROMPT=You are a helpful AI streaming assistant. Keep responses concise and engaging.
